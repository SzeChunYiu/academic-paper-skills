{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/academic-paper-skills/blob/main/skills/nature-shared/release-contracts/publication-release-manifest.schema.json",
  "title": "Publication Release Integrity Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "canonical_paper_id",
    "requested_state",
    "authority",
    "manuscript_candidates",
    "artifacts",
    "package"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "release_id": {"type": "string", "minLength": 1},
    "canonical_paper_id": {"type": "string", "minLength": 1},
    "requested_state": {
      "enum": ["submission_ready", "publication_ready", "public_posting_ready"]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manuscript_id", "manuscript_artifact_id", "claim_ledger_artifact_id"],
      "properties": {
        "manuscript_id": {"type": "string", "minLength": 1},
        "manuscript_artifact_id": {"type": "string", "minLength": 1},
        "claim_ledger_artifact_id": {"type": "string", "minLength": 1}
      }
    },
    "manuscript_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/manuscriptCandidate"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "package": {
      "oneOf": [
        {"$ref": "#/$defs/zipPackage"},
        {"$ref": "#/$defs/fileSetPackage"}
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "manuscriptCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manuscript_id", "sha256", "disposition", "reason"],
      "properties": {
        "manuscript_id": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "disposition": {
          "enum": [
            "authoritative",
            "superseded",
            "historical_provenance",
            "excluded_incompatible",
            "withdrawn",
            "quarantined"
          ]
        },
        "superseded_by": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "authoritative"}}},
          "then": {"required": ["artifact_id"]}
        },
        {
          "if": {"properties": {"disposition": {"const": "superseded"}}},
          "then": {"required": ["superseded_by"]}
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "role", "path", "sha256", "byte_count"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "role": {
          "enum": [
            "reader_manuscript",
            "claim_ledger",
            "manuscript_source",
            "supplement",
            "submission_component",
            "reproducibility_component",
            "release_receipt",
            "other"
          ]
        },
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 0}
      }
    },
    "packageMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_path", "artifact_id"],
      "properties": {
        "member_path": {"$ref": "#/$defs/relativePath"},
        "artifact_id": {"type": "string", "minLength": 1}
      }
    },
    "zipPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "path", "sha256", "byte_count", "members"],
      "properties": {
        "format": {"const": "zip"},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 0},
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/packageMember"}
        }
      }
    },
    "fileSetPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "members"],
      "properties": {
        "format": {"const": "file_set"},
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/packageMember"}
        }
      }
    }
  }
}
