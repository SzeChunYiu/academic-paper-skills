{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/academic-paper-skills/blob/main/skills/nature-shared/analysis-contracts/research-integrity-ledger.schema.json",
  "title": "Research Integrity Verification Ledger",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "manuscript_id", "sources", "claims", "evidence_receipts", "citation_usages", "release"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manuscript_id": {"type": "string", "minLength": 1},
    "authoring_agent_id": {"type": "string"},
    "verification_scope": {"enum": ["full_manuscript", "partial"]},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "evidence_receipts": {"type": "array", "items": {"$ref": "#/$defs/evidenceReceipt"}},
    "citation_usages": {"type": "array", "items": {"$ref": "#/$defs/citationUsage"}},
    "release": {
      "type": "object",
      "required": ["requested_state"],
      "properties": {
        "requested_state": {
          "enum": ["draft", "review", "submission_ready", "publication_ready", "simulated_publication_ready_for_target"]
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "object",
      "required": ["scheme", "value"],
      "properties": {
        "scheme": {"enum": ["doi", "datacite_doi", "pmid", "pmcid", "arxiv", "isbn", "url", "handle", "other"]},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "required": ["source_id", "source_type", "identifiers", "bibliographic"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^S[0-9A-Za-z_.:-]+$"},
        "source_type": {"type": "string", "minLength": 1},
        "identifiers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}},
        "bibliographic": {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "authors": {"type": "array", "items": {"type": "string"}},
            "year": {"type": ["integer", "null"]},
            "venue": {"type": "string"}
          }
        },
        "declared_publication_status": {
          "enum": ["ACTIVE", "CORRECTED", "RETRACTED", "WITHDRAWN", "EXPRESSION_OF_CONCERN", "UNKNOWN"]
        },
        "bibliography_only": {"type": "boolean"}
      }
    },
    "independentCheck": {
      "type": "object",
      "required": ["status", "verifier_id"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "NOT_DONE"]},
        "verifier_id": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      }
    },
    "claim": {
      "type": "object",
      "required": ["claim_id", "location", "text", "claim_class", "risk", "release_status", "independent_check"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^C[0-9A-Za-z_.:-]+$"},
        "location": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "claim_class": {
          "enum": [
            "definition", "empirical_result", "formal_claim", "method", "interpretation", "literature_fact",
            "figure_or_table", "statistics", "availability_or_compliance", "causal", "clinical_or_safety",
            "novelty_or_priority", "quantitative_result", "legal_or_policy", "quotation", "other"
          ]
        },
        "risk": {"enum": ["normal", "high"]},
        "release_status": {
          "enum": [
            "VERIFIED", "BOUNDED_INFERENCE", "COHERENT_DEFINITION", "NOT_APPLICABLE", "SUPPORTED_INTERNAL",
            "UNRESOLVED", "CONTRADICTED", "BLOCKED", "NOT_ASSESSABLE"
          ]
        },
        "independent_check": {"$ref": "#/$defs/independentCheck"},
        "counterevidence_search": {
          "type": "object",
          "properties": {
            "status": {"enum": ["DONE", "NOT_APPLICABLE", "UNRESOLVED"]},
            "notes": {"type": "string"}
          }
        }
      }
    },
    "evidenceReceipt": {
      "type": "object",
      "required": ["receipt_id", "claim_id", "warrant_type", "verification_method", "support_status"],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^E[0-9A-Za-z_.:-]+$"},
        "claim_id": {"type": "string"},
        "warrant_type": {"enum": ["source", "literature", "author_data", "analysis", "proof", "method_record", "definition", "not_applicable"]},
        "source_id": {"type": "string"},
        "locator": {"type": "string"},
        "evidence_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "artifact_pointer": {"type": "string"},
        "verification_method": {
          "enum": [
            "registry_lookup", "publisher_or_primary_record", "fulltext_span_check", "deterministic_recompute",
            "deterministic_derivation", "human_review", "independent_model_with_retrieved_source", "authoritative_project_record"
          ]
        },
        "support_status": {"enum": ["ENTAILS", "BOUNDS", "PARTIAL", "CONTRADICTS", "NOT_CHECKED"]},
        "scope_match": {"enum": ["MATCH", "NARROWER", "BROADER", "MISMATCH", "NOT_CHECKED"]},
        "verifier_id": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "citationUsage": {
      "type": "object",
      "required": ["citation_id", "source_id", "location", "claim_ids"],
      "properties": {
        "citation_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
