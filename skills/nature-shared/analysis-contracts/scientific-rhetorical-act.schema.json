{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/academic-paper-skills/schemas/scientific-rhetorical-act.schema.json",
  "title": "Scientific rhetorical act and result-state record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "manuscript_scope",
    "acts",
    "cross_surface_consistency",
    "release"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "minLength": 1},
    "manuscript_scope": {"type": "string", "minLength": 1},
    "acts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/act"}
    },
    "cross_surface_consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "surfaces", "optimism_drift_detected", "notes"],
      "properties": {
        "checked": {"type": "boolean"},
        "surfaces": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "optimism_drift_detected": {"type": "boolean"},
        "notes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "notes"],
      "properties": {
        "decision": {"enum": ["PASS", "REVIEW", "BLOCKED"]},
        "notes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "act": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "act_id",
        "result_id",
        "section",
        "rhetorical_act",
        "evidence_state",
        "claimed_state",
        "analysis_role",
        "prespecification",
        "scientific_direction",
        "target",
        "observation",
        "uncertainty",
        "scientific_consequence",
        "allowed_inference",
        "forbidden_inference",
        "reader_job",
        "wording_plan",
        "placement",
        "status"
      ],
      "properties": {
        "act_id": {"type": "string", "minLength": 1},
        "result_id": {"type": "string", "minLength": 1},
        "claim_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "section": {"type": "string", "minLength": 1},
        "rhetorical_act": {
          "enum": [
            "observation",
            "estimate",
            "comparison",
            "explanation",
            "discriminator",
            "validation",
            "generalization",
            "qualification",
            "interpretation",
            "implication",
            "control_interpretation",
            "sensitivity_interpretation",
            "failure_boundary",
            "handoff"
          ]
        },
        "evidence_state": {
          "enum": [
            "descriptive",
            "directional_supported",
            "superiority_supported",
            "ordinary_non_significant",
            "inconclusive",
            "evidence_of_absence",
            "equivalence_supported",
            "noninferiority_supported",
            "harm_supported",
            "failed_prespecified_hypothesis",
            "failed_replication",
            "contradictory_evidence",
            "heterogeneity_supported",
            "robustness_supported",
            "sensitivity_changes_claim",
            "positive_control",
            "negative_control",
            "unexpected_observation",
            "exploratory_post_hoc",
            "threshold_result",
            "boundary_failure"
          ]
        },
        "claimed_state": {
          "enum": [
            "descriptive_only",
            "directional_effect",
            "superiority",
            "no_clear_difference",
            "inconclusive",
            "bounded_absence",
            "equivalence",
            "noninferiority",
            "harm",
            "failed_hypothesis",
            "failed_replication",
            "contradiction",
            "heterogeneity",
            "robustness",
            "assumption_dependent",
            "control_success",
            "control_failure",
            "exploratory_pattern",
            "threshold_met",
            "threshold_not_met",
            "boundary"
          ]
        },
        "analysis_role": {
          "enum": [
            "primary_confirmatory",
            "secondary_confirmatory",
            "descriptive",
            "exploratory",
            "validation",
            "positive_control",
            "negative_control",
            "robustness",
            "sensitivity",
            "adverse_harm",
            "replication"
          ]
        },
        "prespecification": {
          "enum": ["prespecified", "post_hoc", "not_applicable", "unclear"]
        },
        "scientific_direction": {
          "enum": ["beneficial", "harmful", "increase", "decrease", "near_zero", "mixed", "not_applicable"]
        },
        "target": {"type": "string", "minLength": 1},
        "observation": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "string", "minLength": 1},
        "scientific_consequence": {"type": "string", "minLength": 1},
        "allowed_inference": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "forbidden_inference": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "reader_job": {"type": "string", "minLength": 1},
        "wording_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lead_message", "quantitative_anchor", "qualification", "handoff"],
          "properties": {
            "lead_message": {"type": "string", "minLength": 1},
            "quantitative_anchor": {"type": "string"},
            "qualification": {"type": "string"},
            "handoff": {"type": "string"}
          }
        },
        "absence_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "meaningful_region", "status"],
          "properties": {
            "method": {"type": "string", "minLength": 1},
            "meaningful_region": {"type": "string", "minLength": 1},
            "margin": {"type": "string"},
            "status": {"enum": ["prespecified", "post_hoc_qualified", "not_applicable"]}
          }
        },
        "heterogeneity_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["comparison", "method", "result"],
          "properties": {
            "comparison": {"type": "string", "minLength": 1},
            "method": {"type": "string", "minLength": 1},
            "result": {"type": "string", "minLength": 1}
          }
        },
        "control_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["control_type", "expected_pattern", "observed_pattern", "validates"],
          "properties": {
            "control_type": {"enum": ["positive", "negative"]},
            "expected_pattern": {"type": "string", "minLength": 1},
            "observed_pattern": {"type": "string", "minLength": 1},
            "validates": {"type": "string", "minLength": 1}
          }
        },
        "display_binding": {"type": "string"},
        "placement": {"enum": ["abstract", "main_text", "methods", "table", "figure", "caption", "supplement", "omitted"]},
        "status": {"enum": ["retained", "compress", "move", "review", "blocked", "omit"]}
      }
    }
  }
}
