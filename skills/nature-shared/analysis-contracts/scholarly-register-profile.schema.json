{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/academic-paper-skills/scholarly-register-profile.schema.json",
  "title": "Scholarly register observation profile",
  "description": "Persistent, copyright-safe observations about section- and archetype-specific scholarly language. Records rhetorical functions and habits, never reusable source sentences or phrase templates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "mode",
    "target",
    "article_type",
    "archetype",
    "evidence_sources",
    "sections",
    "manuscript_voice_invariants",
    "cross_section_register_transitions",
    "copyright_boundary",
    "unresolved_gaps",
    "release"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": ["local_section", "whole_manuscript"]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "article_type": {
      "type": "string",
      "minLength": 1
    },
    "archetype": {
      "type": "string",
      "minLength": 1
    },
    "evidence_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_type", "reference", "scope", "support", "transfer_limit"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_type": {
            "enum": ["corpus_meta", "editorial_guidance", "deep_paper"]
          },
          "reference": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "support": {"type": "string", "minLength": 1},
          "transfer_limit": {"type": "string", "minLength": 1}
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_kind",
          "reader_job",
          "rhetorical_mode",
          "opening_moves",
          "paragraph_nuclei",
          "argument_tempo",
          "agency",
          "tense",
          "stance",
          "syntax_rhythm",
          "citation_integration",
          "numerical_formal_density",
          "list_box_use",
          "figure_table_interaction",
          "transition_behavior",
          "closing_handoff",
          "deliberately_absent",
          "legitimate_alternatives",
          "transfer_decision",
          "confidence"
        ],
        "properties": {
          "section_kind": {
            "enum": [
              "title",
              "abstract",
              "key_points_highlights",
              "introduction",
              "related_work",
              "theory_formulation",
              "methods",
              "results",
              "discussion",
              "limitations",
              "conclusion",
              "caption_legend",
              "table",
              "supplement",
              "availability_compliance",
              "other"
            ]
          },
          "reader_job": {"type": "string", "minLength": 1},
          "rhetorical_mode": {"type": "string", "minLength": 1},
          "opening_moves": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "paragraph_nuclei": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "argument_tempo": {"type": "string", "minLength": 1},
          "agency": {"type": "string", "minLength": 1},
          "tense": {"type": "string", "minLength": 1},
          "stance": {"type": "string", "minLength": 1},
          "syntax_rhythm": {"type": "string", "minLength": 1},
          "citation_integration": {"type": "string", "minLength": 1},
          "numerical_formal_density": {"type": "string", "minLength": 1},
          "list_box_use": {"type": "string", "minLength": 1},
          "figure_table_interaction": {"type": "string", "minLength": 1},
          "transition_behavior": {"type": "string", "minLength": 1},
          "closing_handoff": {"type": "string", "minLength": 1},
          "deliberately_absent": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "legitimate_alternatives": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "transfer_decision": {
            "enum": ["adopt", "adapt", "reject", "unresolved"]
          },
          "confidence": {
            "enum": ["low", "moderate", "high"]
          }
        }
      }
    },
    "manuscript_voice_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "cross_section_register_transitions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "copyright_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sentences_stored", "phrase_templates_stored", "distinctive_wording_reused", "note"],
      "properties": {
        "source_sentences_stored": {"const": false},
        "phrase_templates_stored": {"const": false},
        "distinctive_wording_reused": {"const": false},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "unresolved_gaps": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "notes"],
      "properties": {
        "decision": {
          "enum": ["PASS", "REVIEW", "BLOCKED"]
        },
        "notes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
