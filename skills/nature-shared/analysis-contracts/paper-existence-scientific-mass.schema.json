{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzeChunYiu/academic-paper-skills/paper-existence-scientific-mass.schema.json",
  "title": "Paper existence and scientific mass decision ledger",
  "type": "object",
  "required": [
    "schema_version",
    "paper_id",
    "surviving_claim",
    "hostile_panel",
    "scientific_mass",
    "novelty",
    "comparisons",
    "external_validity",
    "integrity_vs_validity",
    "sibling_overlap",
    "next_discriminator",
    "decision"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "paper_id": {"type": "string", "minLength": 1},
    "surviving_claim": {
      "type": "object",
      "required": ["plain_language", "claim_type", "posterior_change", "status"],
      "properties": {
        "plain_language": {"type": "string", "minLength": 1},
        "claim_type": {"enum": ["empirical", "theoretical", "benchmark", "systems", "resource", "methodology", "mixed"]},
        "posterior_change": {"type": "string", "minLength": 1},
        "status": {"enum": ["established", "partially_established", "unsupported", "withdrawn", "unresolved"]}
      },
      "additionalProperties": false
    },
    "hostile_panel": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["lens", "fatal_objection", "severity", "closure_test"],
        "properties": {
          "lens": {"enum": ["field_editor", "methods_benchmark_statistics", "theory", "systems_reproducibility", "literature_portfolio", "other"]},
          "fatal_objection": {"type": "string"},
          "severity": {"enum": ["none", "minor", "major", "fatal", "unresolved"]},
          "closure_test": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "scientific_mass": {
      "type": "object",
      "required": ["raw_rows_or_cases", "independent_unit_type", "independent_unit_count", "dependence_notes", "failure_opportunities", "adverse_or_null_results"],
      "properties": {
        "raw_rows_or_cases": {"type": ["integer", "null"], "minimum": 0},
        "independent_unit_type": {"type": "string", "minLength": 1},
        "independent_unit_count": {"type": ["number", "null"], "minimum": 0},
        "dependence_notes": {"type": "string"},
        "failure_opportunities": {"type": "string"},
        "adverse_or_null_results": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "novelty": {
      "type": "object",
      "required": ["nearest_external_works", "component_novelty", "composition_novelty", "emergent_result", "theory_lineage"],
      "properties": {
        "nearest_external_works": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "component_novelty": {"type": "string"},
        "composition_novelty": {"type": "string"},
        "emergent_result": {"type": "string"},
        "theory_lineage": {"type": "string"}
      },
      "additionalProperties": false
    },
    "comparisons": {
      "type": "object",
      "required": ["minimum_mechanism", "baseline_roles", "interface_parity", "scorer_latitude", "designer_advantage"],
      "properties": {
        "minimum_mechanism": {"type": "string"},
        "baseline_roles": {"type": "array", "items": {"type": "string"}},
        "interface_parity": {"enum": ["matched", "mismatched", "not_applicable", "unresolved"]},
        "scorer_latitude": {"enum": ["low", "moderate", "high", "not_applicable", "unresolved"]},
        "designer_advantage": {"enum": ["low", "moderate", "high", "not_applicable", "unresolved"]}
      },
      "additionalProperties": false
    },
    "external_validity": {
      "type": "object",
      "required": ["level", "description", "claim_scope_matches_level"],
      "properties": {
        "level": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6", "L7"]},
        "description": {"type": "string"},
        "claim_scope_matches_level": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "integrity_vs_validity": {
      "type": "object",
      "required": ["integrity_evidence", "scientific_validity_evidence", "integrity_substituted_for_validity"],
      "properties": {
        "integrity_evidence": {"type": "array", "items": {"type": "string"}},
        "scientific_validity_evidence": {"type": "array", "items": {"type": "string"}},
        "integrity_substituted_for_validity": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "sibling_overlap": {
      "type": "object",
      "required": ["siblings", "reader_visible_separation", "merge_test"],
      "properties": {
        "siblings": {"type": "array", "items": {"type": "string"}},
        "reader_visible_separation": {"enum": ["clear", "partial", "weak", "not_applicable", "unresolved"]},
        "merge_test": {"type": "string"}
      },
      "additionalProperties": false
    },
    "next_discriminator": {
      "type": "object",
      "required": ["task", "why_it_changes_decision", "closure_test", "blocks_further_polish"],
      "properties": {
        "task": {"type": "string"},
        "why_it_changes_decision": {"type": "string"},
        "closure_test": {"type": "string"},
        "blocks_further_polish": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["disposition", "top_tier_status", "second_tier_status", "reason"],
      "properties": {
        "disposition": {"enum": ["WRITE_FULL_PAPER", "WAIT_FOR_EVIDENCE", "MERGE_WITH_SIBLING", "RECLASSIFY_AS_NOTE", "KILL_CLAIM", "UNRESOLVED"]},
        "top_tier_status": {"enum": ["candidate", "not_yet", "not_appropriate", "unresolved"]},
        "second_tier_status": {"enum": ["candidate", "not_yet", "not_appropriate", "unresolved"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
