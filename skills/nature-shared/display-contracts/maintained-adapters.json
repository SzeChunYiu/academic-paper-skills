  "profiles": [
    {
      "adapter_id": "paired-change",
      "profile_is_not_universal_rule": true,
      "applies_when": {
        "reader_tasks": ["compare_change"],
        "any_data_structures": ["paired", "repeated_measure"]
      },
      "candidate_families": ["connected_points", "paired_difference", "slopegraph", "repeated_measure_trajectory"],
      "disallowed_families": ["independent_mean_bar"],
      "obligations": [
        "Preserve the within-unit pairing in the visual encoding.",
        "Define the paired estimand and uncertainty unit.",
        "Do not visually treat repeated measurements as independent observations."
      ],
      "source_refs": ["weissgerber-2015"]
    },
    {
      "adapter_id": "distribution",
      "profile_is_not_universal_rule": true,
      "applies_when": {
