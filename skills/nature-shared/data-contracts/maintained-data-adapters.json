{
  "catalog_schema_version": "1.0.0",
  "catalog_id": "data-integrity-maintained-adapters-2026-08-28",
  "reviewed_at": "2026-08-28",
  "selection_mode": "applicable_obligations_not_universal_quality_model",
  "scope": "Maintained cross-domain and modality-specific obligations for data identity, integrity, lineage, quality-control traceability, governance, and release. This catalog is not a complete legal, institutional, funder, repository, or disciplinary rulebook.",
  "evidence_registry_file": "data-integrity-evidence-registry.json",
  "profiles": [
    {
      "adapter_id": "general-tabular-observational",
      "profile_is_not_universal_rule": true,
      "applies_when": {
        "any_modalities": [
          "tabular",
          "relational_database",
          "survey"
        ],
        "any_study_contexts": [
          "observational_association",
          "observational_causal"
        ],
        "any_sensitivity_tags": []
      },
      "obligations": [
        "Preserve raw and analysis-ready snapshots with a data dictionary, scientific-unit key, units, missing-value codes, denominators, and versioned cleaning decisions.",
        "Assess conformance, completeness/missingness, uniqueness, and context-specific plausibility without collapsing them into one quality score."
      ],
      "required_qc_dimensions": [
        "schema_conformance",
        "unit_uniqueness",
        "missingness"
      ],
      "hard_checks": [
        "raw_fixity",
        "transformation_lineage",
        "analysis_binding",
        "data_decision_visibility",
        "semantic_schema",
        "quality_receipts",
        "record_count_lineage",
        "release_integrity"
      ],
      "source_refs": [
        "kahn-2016-dq",
        "weiskopf-2013-ehr-dq",
        "frictionless-table-schema",
        "van-den-broeck-2005-cleaning"
      ],
      "transfer_limits": [
        "No universal completeness or plausibility threshold; secondary operational data need source- and use-specific validation."
      ]
    },
    {
      "adapter_id": "human-clinical-sensitive",
