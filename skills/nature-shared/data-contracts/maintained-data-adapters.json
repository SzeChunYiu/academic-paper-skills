      "source_refs": [
        "springer-sensitive-data",
        "ukds-anonymisation",
        "rocher-2019-reidentification",
        "sterne-2009-missing"
      ],
      "transfer_limits": [
        "Exact law, consent, ethics approval, institution, and data-access authority must be resolved live; this adapter does not certify anonymization or compliance."
      ]
    },
