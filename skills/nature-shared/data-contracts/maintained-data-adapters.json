      },
      "obligations": [
        "Resolve consent/authority, direct and indirect identifier risk, missingness/attrition, and an authorized release or controlled-access route.",
        "Keep participant communication, technical de-identification, access governance, and legal/ethical authority separate."
      ],
      "required_qc_dimensions": [
        "missingness",
        "identifier_risk_assessment"
      ],
      "hard_checks": [
        "raw_fixity",
        "transformation_lineage",
